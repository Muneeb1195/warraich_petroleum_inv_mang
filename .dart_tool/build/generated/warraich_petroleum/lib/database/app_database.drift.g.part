    this.description = const Value.absent(),
    required DateTime date,
    this.shiftId = const Value.absent(),
    this.createdBy = const Value.absent(),
    this.createdAt = const Value.absent(),
  }) : category = Value(category),
       amount = Value(amount),
       date = Value(date);
